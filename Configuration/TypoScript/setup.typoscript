manifest = PAGE
manifest {
    typeNum = 835
    config {
        no_cache = 0
        sendCacheHeaders = 1
        debug = 0
        admPanel = 0
        disableAllHeaderCode = 1
        additionalHeaders.10 {
            header = Content-Type: application/manifest+json; charset=utf-8
            replace = 1
        }
    }

    10 = USER
    10 {
        userFunc = Woit\WitPwamanifest\Service\PwamanifestService->manifestConfiguration
    }
}

serviceWorker = PAGE
serviceWorker {
    typeNum = 836
    config {
        no_cache = 0
        sendCacheHeaders = 1
        debug = 0
        admPanel = 0
        disableAllHeaderCode = 1
        additionalHeaders.10 {
            header = Content-Type: application/javascript; charset=utf-8
            replace = 1
        }
        additionalHeaders.20 {
            header = Service-Worker-Allowed: /
            replace = 1
        }
    }

    10 = USER
    10 {
        userFunc = Woit\WitPwamanifest\Service\PwamanifestService->serviceWorkerScript
    }
}

##############
#### PAGE ####
##############
page = PAGE
page {
    headerData {
        999999 = TEXT
        999999 {
            typolink {
                parameter.data = page:uid
                additionalParams = &type=835
                forceAbsoluteUrl = 1
                returnLast = url
            }
            wrap = <link rel="manifest" href="|">
        }
        999998 = USER
        999998 {
            userFunc = Woit\WitPwamanifest\Service\PwamanifestService->serviceWorkerRegistration
        }
    }
}
